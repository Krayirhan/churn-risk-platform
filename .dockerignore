# ============================================================================
# .dockerignore — Docker build context'ine GİRMEMESİ gereken dosyalar
# ============================================================================
# NEDEN ÖNEMLİ?
#   Docker build context (COPY .) gönderilirken gereksiz dosyalar hariç tutulur.
#   → Daha hızlı build, daha küçük imaj, güvenlik.
# ============================================================================

# ─── Git ───
.git
.gitignore

# ─── Python ───
__pycache__
*.py[cod]
*.egg-info
dist
build

# ─── Virtual Environment ───
.venv
venv
ENV

# ─── IDE ───
.vscode
.idea

# ─── Jupyter ───
.ipynb_checkpoints
notebooks/

# ─── Test & QA ───
tests/
.pytest_cache
htmlcov
.coverage
coverage.xml

# ─── Logs ───
logs/
*.log

# ─── Data (büyük dosyalar) ───
data/
*.csv

# ─── Model artifacts (volume ile mount edilmeli) ───
artifacts/*.pkl
artifacts/*.npz

# ─── Docker (kendini dahil etme) ───
Dockerfile.csharp
Dockerfile.frontend
docker-compose*.yml
.dockerignore

# ─── Docs & Markdown ───
docs/
CHANGELOG.md
CONTRIBUTING.md
LICENSE

# ─── Frontend & C# (ayrı Dockerfile'ları var) ───
frontend-dashboard/
backend-csharp/

# ─── Scripts ───
scripts/

# ─── OS ───
.DS_Store
Thumbs.db

# ─── Env ───
.env
.env.*
!.env.example

# ─── CI/CD & Config ───
.github/
.pre-commit-config.yaml
Makefile
