# Frontend Dashboard — nginx:alpine (~7 MB)
FROM nginx:alpine

# Copy static files to nginx html directory
COPY frontend-dashboard/ /usr/share/nginx/html/

# Custom nginx config for port 5500
RUN printf 'server {\n    listen 5500;\n    server_name localhost;\n    location / {\n        root /usr/share/nginx/html;\n        index index.html;\n        try_files $uri $uri/ /index.html;\n    }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 5500

CMD ["nginx", "-g", "daemon off;"]
