# C# API Backend Dockerfile
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src
COPY ["backend-csharp/ChurnRiskAPI.csproj", "backend-csharp/"]
RUN dotnet restore "backend-csharp/ChurnRiskAPI.csproj"

COPY . .
WORKDIR "/src/backend-csharp"
RUN dotnet build "ChurnRiskAPI.csproj" -c Release -o /app/build

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/build .

ENV ASPNETCORE_URLS=http://+:5001
EXPOSE 5001

ENTRYPOINT ["dotnet", "ChurnRiskAPI.dll"]
