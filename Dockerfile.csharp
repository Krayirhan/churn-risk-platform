# C# API Backend Dockerfile
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src
COPY backend-csharp/ChurnRiskAPI.csproj ./
RUN dotnet restore "ChurnRiskAPI.csproj"

COPY backend-csharp/ .
RUN dotnet build "ChurnRiskAPI.csproj" -c Release -o /app/build

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/build .

ENV ASPNETCORE_URLS=http://+:5001
EXPOSE 5001

ENTRYPOINT ["dotnet", "ChurnRiskAPI.dll"]
