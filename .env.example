# ============================================================================
# .env.example — Ortam Değişkenleri Şablonu
# ============================================================================
# Bu dosyayı `.env` olarak kopyalayın ve değerleri ortamınıza göre güncelleyin:
#   cp .env.example .env
# ============================================================================

# ─── Python ───
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ─── FastAPI Server ───
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=info

# ─── C# API Gateway ───
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5001
PythonAPI__BaseUrl=http://localhost:8000

# ─── Docker Compose ───
COMPOSE_PROJECT_NAME=churn-risk-platform
