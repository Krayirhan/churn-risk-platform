# ============================================================================
# .env.example — Ortam Değişkenleri Şablonu
# ============================================================================
# Bu dosyayı `.env` olarak kopyalayın ve değerleri ortamınıza göre güncelleyin:
#   cp .env.example .env
# ============================================================================

# ─── Python ───
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ─── FastAPI Server ───
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=info

# ─── Güvenlik ───
# API_KEY set edilmezse auth devre dışı kalır (geliştirme modu)
# API_KEY=your-secret-api-key-here

# ─── CORS ───
# Virgülle ayrılmış origin listesi. Varsayılan: * (tüm origin'ler)
# CORS_ALLOW_ORIGINS=http://localhost:5500,http://localhost:3000

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# ─── C# API Gateway ───
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5001
PythonAPI__BaseUrl=http://localhost:8000

# ─── Docker Compose ───
COMPOSE_PROJECT_NAME=churn-risk-platform
